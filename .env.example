# ============================================================
# 环境变量模板（可提交 Git）
# 复制为 .env.local 后填入真实值；.env.local 已被 .gitignore 忽略
# ============================================================

# --- Notion ---
NOTION_KEY=
NOTION_PAGE_ID=
# 若使用数据库 ID，可与 NOTION_PAGE_ID 二选一
NOTION_DATABASE_ID=

# --- 博客后台 /admin 登录（middleware）---
AUTH_USER=
AUTH_PASS=
# 商户系统签发 login_token 验签密钥（HS256）；由商户部署/首次进入后台写入 Vercel
BLOG_LOGIN_JWT_SECRET=
# 设为 1 或 true 时关闭 ?auth_u=&auth_p= 明文 URL 登录（默认开启 legacy）
# DISABLE_LEGACY_URL_PASSWORD=false

# --- 兰空图床（后台上传 / Gallery 图库）---
# 仅作为共享配置读取失败/尚未部署 P3 表时的兼容回退；日常切换由 blog_image_host_config 控制
LSKY_URL=https://img.x1file.top
# 可填 1|xxx 或 Bearer 1|xxx，代码会自动处理
LSKY_TOKEN=
# 本站转发到兰空前的单文件上限（MB），默认 50；兰空后台也需放开同等或更大限制
LSKY_MAX_UPLOAD_MB=50

# --- Gallery 图库 · Supabase（同时承载全平台共享图床配置，见 migration 012）---
# 共用 1 个 Supabase Project；多租户靠 BLOG_SITE_ID 隔离（= merchant_services.id）
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 本 Blog 租户 ID（商户系统部署时写入）
BLOG_SITE_ID=
# 本站图库容量上限 GB（默认 50）
GALLERY_QUOTA_GB=50

# --- 可选 ---
# 站点公网地址（轻量 SEO：canonical / Open Graph / sitemap / robots；由商户系统在部署时注入）
# NEXT_PUBLIC_SITE_URL=https://www.example.com
# NEXT_PUBLIC_THEME=gallery
# DISABLE_REMOTE_THEME_CACHE=1
# ISR 过期秒数（默认 3600；内容更新主要靠后台保存触发的按需刷新）
# NEXT_REVALIDATE_SECONDS=3600
# 预热请求使用的博客公网地址（与 admin 不同域时必填，如 https://你的博客域名.com）
# BLOG_PUBLIC_URL=https://example.com
# Vercel 全量重部署 Deploy Hook（后台「全量刷新」；由商户系统在部署时注入）
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
# Vercel 部署保护开启时，填入 Automation Bypass Secret 以便 ISR 预热穿透 CDN
# VERCEL_AUTOMATION_BYPASS_SECRET=

# --- 爬虫元数据定时入库（Gallery 主题 · 见 supabase/migrations/005_crawler_ingest_queue.sql）---
# 定时任务鉴权（Vercel Cron 自动带 Bearer；外部 cron 需手动传 Authorization: Bearer <secret>）
# CRON_SECRET=
# vercel.json 爬虫 cron 为每日 1 次（UTC 19:00 ≈ 北京时间 03:00），Hobby 计划上限；勿用 0 * * * *
# 每次 cron 最多处理条数（默认 20）
# CRAWLER_INGEST_BATCH_SIZE=20
# 新建文章默认 Notion status（Published | Draft，默认 Published）
# CRAWLER_INGEST_DEFAULT_STATUS=Published

# 封面 blur 占位需远程探测时开启（默认关闭以省 Vercel CPU，SaaS 多租户建议保持关闭）
# ENABLE_REMOTE_IMAGE_PROBE=1

# --- shop 主题 · 关联商品（P18）---
# 主站（商户系统）网关地址；后台「关联商品」下拉经 /api/admin/merchant-products 代理读取
# MERCHANT_API_BASE=https://creator.proplus.onl
# 主站商品列表端点路径（主站需提供该端点，未部署时后台降级为手填 SKU）
# MERCHANT_PRODUCTS_PATH=/api/merchant/products-public
# 可选：服务端到服务端凭据，存在时以 Bearer 头透传给主站
# MERCHANT_API_TOKEN=
